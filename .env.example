# Copy to .env and fill in. Never commit the real .env.
TESTLEDGER_DATABASE_URL=sqlite:///./testledger.db
# SHA-256 hex digest(s) of your API key(s), comma separated.
# Generate with: python -c "import hashlib,sys;print(hashlib.sha256(sys.argv[1].encode()).hexdigest())" YOUR_KEY
TESTLEDGER_API_KEY_HASHES=
TESTLEDGER_MAX_UPLOAD_BYTES=5000000
TESTLEDGER_FLAKY_MIN_RUNS=5
TESTLEDGER_FLAKY_THRESHOLD=0.30
TESTLEDGER_RELEASE_AFTER_PASSES=10
